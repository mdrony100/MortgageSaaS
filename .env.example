APP_NAME=MortgageLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mortgagelens
DB_USERNAME=mortgagelens
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"
# Brevo compatible SMTP (future environment only, never frontend):
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME and MAIL_PASSWORD must come from protected runtime configuration.
PRIVATE_DOCUMENT_DISK=private
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT= — optional S3-compatible private storage endpoint
# No analysis provider credentials are used in Phase 1.

# Phase 2 — server-side only. No paid provider is enabled by default.
BANK_PYTHON=python3
BANK_PARSER_SANDBOX=bwrap
BANK_CLAMAV=clamscan
BANK_FICTIONAL_SCAN_BYPASS=false
BANK_EXTRACTOR=hybrid
BANK_TRANSFER_WINDOW_DAYS=3
BANK_OPENAI_APPROVED=false
OPENAI_API_KEY=
BANK_OPENAI_MODEL=
BANK_OPENAI_SECONDARY_MODEL=
BANK_OPENAI_RESERVATION_MICRO_USD=0
BANK_INTEGRITY_PROVIDER=disabled
BANK_INTEGRITY_APPROVED=false
OCROLUS_ACCESS_TOKEN=
BANK_OCROLUS_RESERVATION_MICRO_USD=0
AWS_SERVER_SIDE_ENCRYPTION=AES256

# Phase3: disabled until approved. Never put server credentials into VITE_* variables.
APPRAISAL_VISION_APPROVED=false
APPRAISAL_VISION_MODEL=
APPRAISAL_VISION_RESERVATION_MICRO_USD=0
GUIDELINE_REVIEWER_IDS=
BILLING_PROVIDER=disabled
BILLING_FAKE_ENABLED=false
BILLING_WEBHOOK_SECRET=

REVIEW_EMAIL_NOTIFICATIONS=false
REVIEW_REPLAY_DAYS=7
